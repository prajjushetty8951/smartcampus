# Frontend-safe values only. Never place private provider keys in Vite client variables.
VITE_APP_MODE=demo
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_MAPS_ENABLED=false

# Flask backend (store in backend/.env, not in the frontend bundle)
FLASK_ENV=development
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
LLM_PROVIDER=demo
LLM_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
